NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ecommerce
REDIS_URL=redis://redis:6379
JWT_SECRET=local-development-secret
PAYMENT_WEBHOOK_SECRET=local-payment-webhook-secret
PAYMENT_GATEWAYS=DEVELOPMENT,MANUAL_BANK_TRANSFER,CASH_ON_DELIVERY
# Production gateway:
# PAYMENT_GATEWAYS=ZARINPAL,CASH_ON_DELIVERY
# ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# ZARINPAL_SANDBOX=false
SHIPPING_PROVIDERS=LOCAL
EMAIL_PROVIDER=development
# Production email:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=shop@example.com
# SMTP_EHLO_NAME=shop.example.com
# SMTP_ALLOW_INVALID_CERTIFICATES=false
SMS_PROVIDER=development
# Production SMS:
# SMS_PROVIDER=kavenegar
# KAVENEGAR_API_KEY=
# KAVENEGAR_SENDER=
OTP_TTL_SECONDS=120
OTP_RETRY_AFTER_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Non-production deterministic code for local/E2E use only:
# OTP_DEVELOPMENT_CODE=123456
# Optional consent-gated server-side Google Analytics 4 forwarding:
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=replace-with-ga4-measurement-protocol-secret
API_PREFIX=api
API_VERSION=1
FEATURE_MEDIA_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_REPORTS_ENABLED=true
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=storage/media
MEDIA_PUBLIC_BASE_URL=/media
MEDIA_MAX_UPLOAD_BYTES=10485760
# For S3-compatible storage (AWS S3, Cloudflare R2, or MinIO):
# MEDIA_S3_BUCKET=ecommerce-media
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_ENDPOINT=https://s3.example.com
# MEDIA_S3_ACCESS_KEY_ID=access-key
# MEDIA_S3_SECRET_ACCESS_KEY=secret-key
# MEDIA_S3_PUBLIC_BASE_URL=https://cdn.example.com
# MEDIA_S3_FORCE_PATH_STYLE=false

# Required only when running `npm run prisma:seed`:
# SEED_OWNER_EMAIL=owner@example.com
# SEED_OWNER_NAME=Store Owner
# SEED_OWNER_PASSWORD=local-owner-password
# SEED_SHOP_NAME=Example Store
# SEED_SHOP_CURRENCY=IRR
# SEED_ORDER_PREFIX=ORD
# SEED_STANDARD_SHIPPING_PRICE=0.00
# Set only for disposable local/CI databases:
# E2E_SEED_FIXTURES=true
# E2E_CUSTOMER_EMAIL=customer@example.test
# E2E_CUSTOMER_PASSWORD=customer-password
