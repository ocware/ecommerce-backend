NODE_ENV=production
PORT=3000
PUBLIC_APP_URL=https://angoshtarsarallah.ir
APP_BIND_ADDRESS=127.0.0.1
APP_IMAGE_REPOSITORY=ecommerce-backend
IMAGE_TAG=latest

POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://ecommerce:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/ecommerce?schema=public
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_TO_AN_INDEPENDENT_RANDOM_WEBHOOK_SECRET
API_PREFIX=api
API_VERSION=1

PAYMENT_GATEWAYS=MANUAL_BANK_TRANSFER,CASH_ON_DELIVERY
SHIPPING_PROVIDERS=LOCAL
EMAIL_PROVIDER=development
SMS_PROVIDER=development

FEATURE_MEDIA_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_REPORTS_ENABLED=true

MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=/app/storage/media
MEDIA_PUBLIC_BASE_URL=/media
MEDIA_MAX_UPLOAD_BYTES=10485760
# MEDIA_S3_BUCKET=ecommerce-media
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_ENDPOINT=https://s3.example.com
# MEDIA_S3_ACCESS_KEY_ID=CHANGE_ME
# MEDIA_S3_SECRET_ACCESS_KEY=CHANGE_ME
# MEDIA_S3_PUBLIC_BASE_URL=https://cdn.example.com
# MEDIA_S3_FORCE_PATH_STYLE=false

SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_NAME=Store Owner
SEED_OWNER_PASSWORD=CHANGE_ME_TO_A_UNIQUE_OWNER_PASSWORD
SEED_SHOP_NAME=Example Store
SEED_SHOP_CURRENCY=USD
SEED_ORDER_PREFIX=ORD
SEED_STANDARD_SHIPPING_PRICE=0.00
