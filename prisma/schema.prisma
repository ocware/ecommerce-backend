generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  OWNER
  ADMIN
  PRODUCT_MANAGER
  ORDER_MANAGER
  SUPPORT
  WAREHOUSE_STAFF
}

enum StaffStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum StaffSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model StaffUser {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  name         String
  passwordHash String
  role         StaffRole
  status       StaffStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions            StaffSession[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  @@index([role])
  @@index([status])
}

model StaffSession {
  id               String             @id @default(uuid()) @db.Uuid
  staffUserId      String             @db.Uuid
  refreshTokenHash String             @unique
  status           StaffSessionStatus @default(ACTIVE)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@index([status])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  staffUserId String  @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  staffUserId String?  @db.Uuid
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([staffUserId])
  @@index([action])
  @@index([createdAt])
}
