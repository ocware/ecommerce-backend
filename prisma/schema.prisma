generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  OWNER
  ADMIN
  PRODUCT_MANAGER
  ORDER_MANAGER
  SUPPORT
  WAREHOUSE_STAFF
}

enum StaffStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum StaffSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum CustomerStatus {
  ACTIVE
  GUEST
  SUSPENDED
  DISABLED
}

enum CustomerSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductVariantStatus {
  ACTIVE
  DISABLED
}

enum InventoryMovementType {
  INITIALIZED
  ADJUSTED
  RESERVED
  RELEASED
  CONFIRMED
  RESTORED
}

enum InventoryReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  ABANDONED
}

enum DiscountMode {
  COUPON
  AUTOMATIC
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum OrderPaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum OrderFulfillmentStatus {
  UNFULFILLED
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum OrderRefundStatus {
  NONE
  PENDING
  PARTIAL
  FULL
  FAILED
}

enum ReturnRequestType {
  RETURN
  EXCHANGE
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  REPLACEMENT_CREATED
  CLOSED
  CANCELLED
}

enum ProductReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CustomerNotificationType {
  ORDER_PLACED
  ORDER_STATUS
  BACK_IN_STOCK
  ACCOUNT
}

enum CmsPageStatus {
  DRAFT
  PUBLISHED
}

enum ConsentSource {
  COOKIE_BANNER
  ACCOUNT
  CHECKOUT
  ADMIN
}

enum AnalyticsEventName {
  PAGE_VIEW
  VIEW_ITEM
  ADD_TO_CART
  BEGIN_CHECKOUT
  PURCHASE
  SEARCH
  SIGN_UP
  LOGIN
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentTransactionKind {
  AUTHORIZATION
  CHARGE
  REFUND
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentCallbackStatus {
  PROCESSING
  PROCESSED
  FAILED
  REJECTED
}

enum PaymentRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ShippingMethodType {
  STANDARD
  EXPRESS
  LOCAL_PICKUP
}

enum ShipmentStatus {
  PENDING
  CREATED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
}

enum MediaAssetType {
  PRODUCT_IMAGE
  CATEGORY_IMAGE
  SHOP_LOGO
  BANNER
  LIBRARY
}

enum MediaAssetStatus {
  PROCESSING
  READY
  FAILED
  DELETED
}

enum NotificationChannel {
  EMAIL
  SMS
  ADMIN
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model StaffUser {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  name         String
  passwordHash String
  role         StaffRole
  status       StaffStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions            StaffSession[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  orderInternalNotes  OrderInternalNote[]
  paymentRefunds      PaymentRefund[]

  @@index([role])
  @@index([status])
}

model StaffSession {
  id                       String             @id @default(uuid()) @db.Uuid
  staffUserId              String             @db.Uuid
  familyId                 String             @default(uuid()) @db.Uuid
  refreshTokenHash         String             @unique
  previousRefreshTokenHash String?            @unique
  status                   StaffSessionStatus @default(ACTIVE)
  expiresAt                DateTime
  lastActiveAt             DateTime           @default(now())
  revokedAt                DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@index([familyId])
  @@index([status])
  @@index([expiresAt])
  @@index([lastActiveAt])
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  staffUserId String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  staffUserId String?  @db.Uuid
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([staffUserId])
  @@index([action])
  @@index([createdAt])
}

model Customer {
  id               String         @id @default(uuid()) @db.Uuid
  email            String?        @unique
  phone            String?        @unique
  name             String
  passwordHash     String?
  status           CustomerStatus @default(ACTIVE)
  marketingConsent Boolean        @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  sessions             CustomerSession[]
  addresses            CustomerAddress[]
  notes                CustomerNote[]
  guestProfiles        GuestCheckoutProfile[]
  carts                Cart[]
  discountRestrictions DiscountCustomer[]
  discountRedemptions  DiscountRedemption[]
  orders               Order[]
  otpChallenges        CustomerOtpChallenge[]
  returnRequests       ReturnRequest[]
  productReviews       ProductReview[]
  wishlistItems        WishlistItem[]
  stockSubscriptions   BackInStockSubscription[]
  notifications        CustomerNotification[]
  consentRecords       ConsentRecord[]
  analyticsEvents      AnalyticsEvent[]
  passwordResetTokens  CustomerPasswordResetToken[]

  @@index([status])
}

model CustomerPasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([expiresAt])
}

model CustomerOtpChallenge {
  id                    String    @id @default(uuid()) @db.Uuid
  customerId            String?   @db.Uuid
  phone                 String
  codeHash              String
  attempts              Int       @default(0)
  expiresAt             DateTime
  verifiedAt            DateTime?
  registrationTokenHash String?   @unique
  registrationExpiresAt DateTime?
  consumedAt            DateTime?
  requestedAt           DateTime  @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([phone, requestedAt])
  @@index([expiresAt])
}

model CustomerSession {
  id                       String                @id @default(uuid()) @db.Uuid
  customerId               String                @db.Uuid
  familyId                 String                @default(uuid()) @db.Uuid
  refreshTokenHash         String                @unique
  previousRefreshTokenHash String?               @unique
  status                   CustomerSessionStatus @default(ACTIVE)
  expiresAt                DateTime
  lastActiveAt             DateTime              @default(now())
  revokedAt                DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([familyId])
  @@index([status])
  @@index([expiresAt])
  @@index([lastActiveAt])
}

model CustomerAddress {
  id         String      @id @default(uuid()) @db.Uuid
  customerId String      @db.Uuid
  type       AddressType @default(SHIPPING)
  fullName   String
  phone      String
  country    String
  province   String
  city       String
  line1      String
  line2      String?
  postalCode String?
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([type])
}

model CustomerNote {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  staffUserId String?  @db.Uuid
  note        String
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([staffUserId])
}

model GuestCheckoutProfile {
  id         String   @id @default(uuid()) @db.Uuid
  email      String?
  phone      String?
  name       String
  metadata   Json?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  customerId String?  @db.Uuid

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([expiresAt])
}

model Brand {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  slug           String   @unique
  description    String?
  logoUrl        String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@index([name])
}

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  parentId       String?  @db.Uuid
  name           String
  slug           String   @unique
  description    String?
  imageUrl       String?
  seoTitle       String?
  seoDescription String?
  position       Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent               Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children             Category[]         @relation("CategoryTree")
  products             ProductCategory[]
  primaryProducts      Product[]          @relation("ProductPrimaryCategory")
  discountRestrictions DiscountCategory[]

  @@index([parentId])
  @@index([isActive, position])
  @@index([name])
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  brandId           String?       @db.Uuid
  primaryCategoryId String?       @db.Uuid
  name              String
  slug              String        @unique
  description      String?
  shortDescription String?
  // Product-specific catalog facts (stone, dimensions, engraving, fit notes).
  // Kept together because these facts vary by product type and are not variants.
  details          Json?
  status           ProductStatus @default(DRAFT)
  seoTitle         String?
  seoDescription   String?
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  brand                Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  primaryCategory      Category?               @relation("ProductPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  variants             ProductVariant[]
  categories           ProductCategory[]
  attributes           ProductAttribute[]
  images               ProductImage[]
  collections          ProductCollectionItem[]
  relatedProducts      RelatedProduct[]        @relation("ProductRelations")
  relatedToProducts    RelatedProduct[]        @relation("RelatedToProductRelations")
  discountRestrictions DiscountProduct[]
  reviews              ProductReview[]
  wishlistItems        WishlistItem[]

  @@index([brandId])
  @@index([primaryCategoryId])
  @@index([status, publishedAt])
  @@index([name])
}

model ProductVariant {
  id        String               @id @default(uuid()) @db.Uuid
  productId String               @db.Uuid
  name      String
  sku       String               @unique
  barcode   String?              @unique
  status    ProductVariantStatus @default(ACTIVE)
  isDefault Boolean              @default(false)
  position  Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  product            Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices             ProductPrice[]
  images             ProductImage[]
  attributeValues    VariantAttributeValue[]
  inventory          InventoryItem?
  cartItems          CartItem[]
  stockSubscriptions BackInStockSubscription[]

  @@index([productId, status])
  @@index([productId, position])
}

model Cart {
  id             String     @id @default(uuid()) @db.Uuid
  customerId     String?    @db.Uuid
  guestTokenHash String?    @unique
  currency       String     @db.VarChar(3)
  status         CartStatus @default(ACTIVE)
  discountCode   String?
  expiresAt      DateTime
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@index([customerId, status])
  @@index([status, expiresAt])
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Discount {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String
  description           String?
  code                  String?      @unique
  mode                  DiscountMode
  type                  DiscountType
  value                 Decimal?     @db.Decimal(18, 2)
  currency              String?      @db.VarChar(3)
  minimumCartAmount     Decimal?     @db.Decimal(18, 2)
  maximumDiscountAmount Decimal?     @db.Decimal(18, 2)
  startsAt              DateTime?
  endsAt                DateTime?
  usageLimit            Int?
  usageCount            Int          @default(0)
  perCustomerUsageLimit Int?
  priority              Int          @default(0)
  isStackable           Boolean      @default(false)
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  products    DiscountProduct[]
  categories  DiscountCategory[]
  customers   DiscountCustomer[]
  redemptions DiscountRedemption[]

  @@index([mode, isActive, priority])
  @@index([startsAt, endsAt])
}

model DiscountProduct {
  discountId String @db.Uuid
  productId  String @db.Uuid

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([productId])
}

model DiscountCategory {
  discountId String @db.Uuid
  categoryId String @db.Uuid

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([discountId, categoryId])
  @@index([categoryId])
}

model DiscountCustomer {
  discountId String @db.Uuid
  customerId String @db.Uuid

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([discountId, customerId])
  @@index([customerId])
}

model DiscountRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  discountId     String   @db.Uuid
  customerId     String?  @db.Uuid
  orderReference String
  amount         Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())

  discount Discount  @relation(fields: [discountId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([discountId, orderReference])
  @@index([customerId, discountId])
  @@index([orderReference])
}

model Order {
  id                       String                 @id @default(uuid()) @db.Uuid
  orderNumber              String                 @unique
  cartId                   String                 @unique @db.Uuid
  customerId               String?                @db.Uuid
  shippingMethodId         String?                @db.Uuid
  status                   OrderStatus            @default(PENDING)
  paymentStatus            OrderPaymentStatus     @default(PENDING)
  fulfillmentStatus        OrderFulfillmentStatus @default(UNFULFILLED)
  refundStatus             OrderRefundStatus      @default(NONE)
  currency                 String                 @db.VarChar(3)
  subtotal                 Decimal                @db.Decimal(18, 2)
  discountTotal            Decimal                @default(0) @db.Decimal(18, 2)
  shippingTotal            Decimal                @default(0) @db.Decimal(18, 2)
  shippingDiscountTotal    Decimal                @default(0) @db.Decimal(18, 2)
  taxTotal                 Decimal                @default(0) @db.Decimal(18, 2)
  grandTotal               Decimal                @db.Decimal(18, 2)
  customerSnapshot         Json
  billingAddressSnapshot   Json
  shippingAddressSnapshot  Json
  pricingSnapshot          Json
  shippingMethodSnapshot   Json?
  invoiceInformation       Json?
  customerNote             String?
  cancellationReason       String?
  cancelledAt              DateTime?
  cancelledByStaffUserId   String?                @db.Uuid
  inventoryReservationEnds DateTime
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  internalNotes   OrderInternalNote[]
  paymentAttempts PaymentAttempt[]
  paymentRefunds  PaymentRefund[]
  shippingMethod  ShippingMethod?     @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  shipments       Shipment[]
  returnRequests  ReturnRequest[]     @relation("OriginalOrderReturns")
  replacementFor  ReturnRequest[]     @relation("ReplacementOrderReturns")

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([fulfillmentStatus, createdAt])
  @@index([shippingMethodId])
}

model OrderItem {
  id                     String   @id @default(uuid()) @db.Uuid
  orderId                String   @db.Uuid
  variantId              String   @db.Uuid
  inventoryReservationId String   @unique @db.Uuid
  productName            String
  productSlug            String
  variantName            String
  sku                    String
  imageUrl               String?
  unitPrice              Decimal  @db.Decimal(18, 2)
  quantity               Int
  lineSubtotal           Decimal  @db.Decimal(18, 2)
  lineDiscount           Decimal  @default(0) @db.Decimal(18, 2)
  lineTax                Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal              Decimal  @db.Decimal(18, 2)
  createdAt              DateTime @default(now())

  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnItems ReturnRequestItem[]

  @@index([orderId])
  @@index([variantId])
  @@index([sku])
}

model ReturnRequest {
  id                 String              @id @default(uuid()) @db.Uuid
  orderId            String              @db.Uuid
  customerId         String              @db.Uuid
  type               ReturnRequestType
  status             ReturnRequestStatus @default(REQUESTED)
  reason             String
  customerNote       String?
  adminNote          String?
  replacementOrderId String?             @unique @db.Uuid
  reviewedByStaffId  String?             @db.Uuid
  reviewedAt         DateTime?
  receivedAt         DateTime?
  closedAt           DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  order            Order               @relation("OriginalOrderReturns", fields: [orderId], references: [id], onDelete: Restrict)
  replacementOrder Order?              @relation("ReplacementOrderReturns", fields: [replacementOrderId], references: [id], onDelete: SetNull)
  customer         Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items            ReturnRequestItem[]

  @@index([customerId, createdAt])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([type, status])
}

model ReturnRequestItem {
  id              String   @id @default(uuid()) @db.Uuid
  returnRequestId String   @db.Uuid
  orderItemId     String   @db.Uuid
  quantity        Int
  reason          String?
  createdAt       DateTime @default(now())

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model ProductReview {
  id                 String              @id @default(uuid()) @db.Uuid
  productId          String              @db.Uuid
  customerId         String              @db.Uuid
  rating             Int
  title              String?
  body               String
  status             ProductReviewStatus @default(PENDING)
  verifiedPurchase   Boolean             @default(false)
  moderatedByStaffId String?             @db.Uuid
  moderatedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([productId, customerId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  productId  String   @db.Uuid
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId, createdAt])
  @@index([productId])
}

model BackInStockSubscription {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @db.Uuid
  variantId  String    @db.Uuid
  isActive   Boolean   @default(true)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([customerId, variantId])
  @@index([variantId, isActive])
  @@index([customerId, createdAt])
}

model CustomerNotification {
  id         String                   @id @default(uuid()) @db.Uuid
  customerId String                   @db.Uuid
  type       CustomerNotificationType
  eventName  String
  eventId    String
  title      String
  body       String
  href       String?
  readAt     DateTime?
  createdAt  DateTime                 @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, eventName, eventId])
  @@index([customerId, readAt, createdAt])
}

model CmsHome {
  id                    String   @id @default("default")
  heroTitle             String
  heroSubtitle          String?
  featuredProductIds    Json
  featuredCategorySlugs Json
  promoTitle            String?
  promoBody             String?
  promoLinkUrl          String?
  promoImageUrl         String?
  promoTiles            Json     @default("[]")
  testimonials          Json     @default("[]")
  updatedByStaffUserId  String?  @db.Uuid
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  slides CmsHomeSlide[]
}

model CmsHomeSlide {
  id                   String   @id @default(uuid()) @db.Uuid
  homeId               String   @default("default")
  title                String
  subtitle             String?
  imageUrl             String
  linkUrl              String?
  position             Int      @default(0)
  isActive             Boolean  @default(true)
  updatedByStaffUserId String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  home CmsHome @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([homeId, isActive, position])
}

model CmsPage {
  id                   String        @id @default(uuid()) @db.Uuid
  slug                 String        @unique
  title                String
  bodyMarkdown         String
  seoTitle             String?
  seoDescription       String?
  status               CmsPageStatus @default(DRAFT)
  updatedByStaffUserId String?       @db.Uuid
  publishedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([status, updatedAt])
}

model ConsentRecord {
  id               String        @id @default(uuid()) @db.Uuid
  customerId       String?       @db.Uuid
  anonymousId      String
  analyticsGranted Boolean
  marketingGranted Boolean
  policyVersion    String
  source           ConsentSource
  createdAt        DateTime      @default(now())

  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  analyticsEvents AnalyticsEvent[]

  @@index([anonymousId, createdAt])
  @@index([customerId, createdAt])
}

model AnalyticsEvent {
  id              String             @id @default(uuid()) @db.Uuid
  customerId      String?            @db.Uuid
  consentRecordId String?            @db.Uuid
  anonymousId     String
  sessionId       String
  name            AnalyticsEventName
  dedupeKey       String             @unique
  payload         Json
  occurredAt      DateTime
  createdAt       DateTime           @default(now())

  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  consentRecord ConsentRecord? @relation(fields: [consentRecordId], references: [id], onDelete: SetNull)

  @@index([name, occurredAt])
  @@index([anonymousId, occurredAt])
  @@index([customerId, occurredAt])
}

model OrderInternalNote {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  staffUserId String   @db.Uuid
  note        String
  createdAt   DateTime @default(now())

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([staffUserId])
}

model PaymentAttempt {
  id               String               @id @default(uuid()) @db.Uuid
  orderId          String               @db.Uuid
  gateway          String
  idempotencyKey   String               @unique
  status           PaymentAttemptStatus @default(CREATED)
  amount           Decimal              @db.Decimal(18, 2)
  currency         String               @db.VarChar(3)
  gatewayReference String?
  redirectUrl      String?
  failureCode      String?
  failureMessage   String?
  metadata         Json?
  startedAt        DateTime             @default(now())
  completedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]
  refunds      PaymentRefund[]

  @@unique([gateway, gatewayReference])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model PaymentTransaction {
  id                          String                   @id @default(uuid()) @db.Uuid
  paymentAttemptId            String                   @db.Uuid
  kind                        PaymentTransactionKind
  status                      PaymentTransactionStatus
  amount                      Decimal                  @db.Decimal(18, 2)
  currency                    String                   @db.VarChar(3)
  idempotencyKey              String                   @unique
  gatewayReference            String?
  gatewayTransactionReference String?
  metadata                    Json?
  occurredAt                  DateTime                 @default(now())
  createdAt                   DateTime                 @default(now())

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@index([paymentAttemptId, occurredAt])
  @@index([gatewayTransactionReference])
}

model PaymentCallback {
  id               String                @id @default(uuid()) @db.Uuid
  gateway          String
  externalEventId  String
  gatewayReference String?
  status           PaymentCallbackStatus @default(PROCESSING)
  payload          Json
  errorCode        String?
  errorMessage     String?
  processedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([gateway, externalEventId])
  @@index([gatewayReference])
  @@index([status, createdAt])
}

model PaymentRefund {
  id                     String              @id @default(uuid()) @db.Uuid
  paymentAttemptId       String              @db.Uuid
  orderId                String              @db.Uuid
  requestedByStaffUserId String              @db.Uuid
  idempotencyKey         String              @unique
  status                 PaymentRefundStatus @default(PENDING)
  amount                 Decimal             @db.Decimal(18, 2)
  currency               String              @db.VarChar(3)
  reason                 String?
  gatewayRefundReference String?
  failureCode            String?
  failureMessage         String?
  metadata               Json?
  completedAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requestedBy    StaffUser      @relation(fields: [requestedByStaffUserId], references: [id], onDelete: Restrict)

  @@index([paymentAttemptId, createdAt])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model ShippingMethod {
  id                    String             @id @default(uuid()) @db.Uuid
  code                  String             @unique
  name                  String
  description           String?
  provider              String
  type                  ShippingMethodType @default(STANDARD)
  currency              String             @db.VarChar(3)
  defaultPrice          Decimal            @db.Decimal(18, 2)
  freeShippingThreshold Decimal?           @db.Decimal(18, 2)
  estimatedMinDays      Int
  estimatedMaxDays      Int
  pickupInstructions    String?
  pickupAddress         Json?
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  rates     ShippingRate[]
  orders    Order[]
  shipments Shipment[]

  @@index([isActive, type])
  @@index([provider])
}

model ShippingZone {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  countries String[]
  provinces String[]
  isActive  Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates ShippingRate[]

  @@index([isActive, priority])
}

model ShippingRate {
  id                    String   @id @default(uuid()) @db.Uuid
  shippingMethodId      String   @db.Uuid
  shippingZoneId        String   @db.Uuid
  price                 Decimal  @db.Decimal(18, 2)
  freeShippingThreshold Decimal? @db.Decimal(18, 2)
  minimumOrderAmount    Decimal? @db.Decimal(18, 2)
  maximumOrderAmount    Decimal? @db.Decimal(18, 2)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)
  shippingZone   ShippingZone   @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)

  @@unique([shippingMethodId, shippingZoneId])
  @@index([shippingZoneId, isActive])
}

model Shipment {
  id                  String         @id @default(uuid()) @db.Uuid
  orderId             String         @db.Uuid
  shippingMethodId    String         @db.Uuid
  provider            String
  providerReference   String?
  trackingCode        String?
  status              ShipmentStatus @default(PENDING)
  cost                Decimal        @db.Decimal(18, 2)
  currency            String         @db.VarChar(3)
  addressSnapshot     Json
  estimatedDeliveryAt DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  metadata            Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  order          Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shippingMethod ShippingMethod          @relation(fields: [shippingMethodId], references: [id], onDelete: Restrict)
  statusHistory  ShipmentStatusHistory[]

  @@unique([provider, providerReference])
  @@index([orderId, createdAt])
  @@index([trackingCode])
  @@index([status, updatedAt])
}

model ShipmentStatusHistory {
  id          String         @id @default(uuid()) @db.Uuid
  shipmentId  String         @db.Uuid
  status      ShipmentStatus
  description String?
  metadata    Json?
  occurredAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

model InventoryItem {
  id                String   @id @default(uuid()) @db.Uuid
  variantId         String   @unique @db.Uuid
  currentStock      Int      @default(0)
  reservedStock     Int      @default(0)
  lowStockThreshold Int      @default(0)
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variant      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements    InventoryMovement[]
  reservations InventoryReservation[]

  @@index([lowStockThreshold])
}

model InventoryMovement {
  id                     String                @id @default(uuid()) @db.Uuid
  inventoryItemId        String                @db.Uuid
  reservationId          String?               @db.Uuid
  type                   InventoryMovementType
  currentStockDelta      Int                   @default(0)
  reservedStockDelta     Int                   @default(0)
  resultingCurrentStock  Int
  resultingReservedStock Int
  reason                 String?
  idempotencyKey         String?               @unique
  staffUserId            String?               @db.Uuid
  metadata               Json?
  createdAt              DateTime              @default(now())

  inventoryItem InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  reservation   InventoryReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, createdAt])
  @@index([reservationId])
  @@index([type, createdAt])
  @@index([staffUserId])
}

model InventoryReservation {
  id                String                     @id @default(uuid()) @db.Uuid
  inventoryItemId   String                     @db.Uuid
  externalReference String                     @unique
  quantity          Int
  status            InventoryReservationStatus @default(ACTIVE)
  expiresAt         DateTime
  confirmedAt       DateTime?
  releasedAt        DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  inventoryItem InventoryItem       @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  movements     InventoryMovement[]

  @@index([inventoryItemId, status])
  @@index([status, expiresAt])
}

model ProductPrice {
  id              String   @id @default(uuid()) @db.Uuid
  variantId       String   @db.Uuid
  currency        String   @db.VarChar(3)
  amount          Decimal  @db.Decimal(18, 2)
  compareAtAmount Decimal? @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, currency])
  @@index([currency])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  variantId String?  @db.Uuid
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@index([variantId])
}

model MediaAsset {
  id                   String           @id @default(uuid()) @db.Uuid
  type                 MediaAssetType
  status               MediaAssetStatus @default(PROCESSING)
  ownerId              String?          @db.Uuid
  catalogImageId       String?          @unique @db.Uuid
  storageProvider      String
  originalKey          String           @unique
  originalUrl          String
  originalFilename     String
  mimeType             String
  sizeBytes            Int
  width                Int?
  height               Int?
  variants             Json?
  altText              String?
  position             Int              @default(0)
  linkUrl              String?
  startsAt             DateTime?
  endsAt               DateTime?
  isActive             Boolean          @default(true)
  processingError      String?
  createdByStaffUserId String           @db.Uuid
  deletedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([type, ownerId, status])
  @@index([type, isActive, position])
  @@index([createdByStaffUserId])
}

model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  eventName         String
  eventId           String
  channel           NotificationChannel
  recipient         String
  subject           String?
  body              String
  status            NotificationStatus  @default(PENDING)
  provider          String?
  providerMessageId String?
  attempts          Int                 @default(0)
  lastError         String?
  metadata          Json?
  sentAt            DateTime?
  readAt            DateTime?
  readByStaffUserId String?             @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([eventName, eventId, channel, recipient])
  @@index([channel, status, createdAt])
  @@index([recipient, createdAt])
  @@index([readAt, createdAt])
}

model ShopSettings {
  id                      String   @id @default("default")
  shopName                String
  shopActive              Boolean  @default(true)
  contactPhone            String?
  contactEmail            String?
  address                 String?
  footerText              String?
  currency                String   @db.VarChar(3)
  taxEnabled              Boolean  @default(false)
  taxRate                 Decimal  @default(0) @db.Decimal(7, 4)
  defaultShippingMethodId String?  @db.Uuid
  orderPrefix             String   @default("ORD") @db.VarChar(12)
  lowStockThreshold       Int      @default(0)
  guestCheckoutEnabled    Boolean  @default(true)
  returnsEnabled          Boolean  @default(true)
  returnWindowDays        Int      @default(7)
  onlinePaymentEnabled    Boolean  @default(true)
  codPaymentEnabled       Boolean  @default(true)
  version                 Int      @default(0)
  updatedByStaffUserId    String?  @db.Uuid
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([defaultShippingMethodId])
  @@index([updatedByStaffUserId])
}

model ProductAttribute {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductAttributeValue[]

  @@unique([productId, name])
  @@index([productId, position])
}

model ProductAttributeValue {
  id          String   @id @default(uuid()) @db.Uuid
  attributeId String   @db.Uuid
  value       String
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  attribute ProductAttribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants  VariantAttributeValue[]

  @@unique([attributeId, value])
  @@index([attributeId, position])
}

model VariantAttributeValue {
  variantId        String @db.Uuid
  attributeValueId String @db.Uuid

  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue ProductAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
}

model ProductCategory {
  productId  String @db.Uuid
  categoryId String @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductCollection {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  slug           String   @unique
  description    String?
  seoTitle       String?
  seoDescription String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products ProductCollectionItem[]

  @@index([isActive])
  @@index([name])
}

model ProductCollectionItem {
  collectionId String @db.Uuid
  productId    String @db.Uuid
  position     Int    @default(0)

  collection ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@index([collectionId, position])
}

model RelatedProduct {
  productId        String @db.Uuid
  relatedProductId String @db.Uuid
  position         Int    @default(0)

  product        Product @relation("ProductRelations", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("RelatedToProductRelations", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
  @@index([relatedProductId])
  @@index([productId, position])
}
